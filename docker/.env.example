# Copy to .env and change every secret before deploying anywhere real.

# Storage backend: firebase | postgres | couchdb (mock is refused in production)
DATA_BACKEND=postgres

# PostgreSQL
PG_DB=almadar
PG_USER=almadar
PG_PASSWORD=change-me
PGPOOL_MAX=10

# CouchDB
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
