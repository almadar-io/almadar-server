{
  "name": "@almadar/server",
  "version": "2.30.0",
  "description": "Shared server infrastructure for Almadar applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    },
    "./stores": {
      "import": "./dist/stores/index.js",
      "types": "./dist/stores/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.decl.json",
    "build:watch": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --passWithNoTests",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@almadar/core": "^10.44.0",
    "@almadar/logger": "^1.10.0",
    "@faker-js/faker": "^9.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@almadar-io/rabit": "^0.64.36",
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@almadar-io/rabit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@almadar/eslint-plugin": "^2.15.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint": "10.0.0",
    "express": "^5.0.0",
    "firebase-admin": "^14.2.0",
    "supertest": "^6.3.0",
    "tsup": "^8.5.1",
    "vitest": "^2.1.0",
    "turbo": "^2.8.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-server.git",
    "directory": "docs/packages/server"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "server",
    "express",
    "middleware"
  ],
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "packageManager": "pnpm@10.30.3"
}
